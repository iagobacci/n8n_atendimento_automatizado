    {
      "parameters": {
        "jsCode": "const item = $input.first()?.json || {};\n\n// Captura se o n8n recebeu erro HTTP (ex: 404, 403, 401, 500)\nif (item.error || item.message || item.cause || (item.statusCode && item.statusCode >= 400)) {\n  const statusCod = item.statusCode || item.httpCode || 'Erro API';\n  const erroMsg = item.message || item.error || 'Evento não encontrado ou permissão negada.';\n  return [{\n    json: {\n      sucesso: false,\n      erro_detalhado: item,\n      mensagem: `Falha ao deletar evento (${statusCod}): ${erroMsg}`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    sucesso: true,\n    resposta_google: item,\n    mensagem: 'Agendamento cancelado com sucesso no Google Calendar.'\n  }\n}];"
      },
