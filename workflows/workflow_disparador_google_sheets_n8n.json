    {
      "parameters": {
        "jsCode": "// LISTA DE SAUDAÇÕES ALEATÓRIAS (Spintax anti-ban)\nconst saudacoes = [\n  \"Olá, tudo bem?\",\n  \"Oi, tudo bem?\",\n  \"Bom dia, tudo bem?\",\n  \"Olá, bom dia, tudo bem?\",\n  \"Olá, bom dia!\",\n  \"Olá, como vai?\",\n  \"Boa tarde, tudo bem?\",\n  \"Oi, boa tarde, tudo bem?\",\n  \"Olá, boa tarde!\",\n  \"Oi, tudo joia por aí?\",\n  \"Olá, tudo joia?\"\n];\n\n// Sorteia uma saudação diferente a cada mensagem\nconst saudacao = saudacoes[Math.floor(Math.random() * saudacoes.length)];\n\n// Pega o nome tratado ou limpa na hora se necessário\nlet nome = $json[\"Nome Tratado (Para Mensagem)\"] || $json[\"Nome do Profissional / Clínica\"] || $json[\"Nome Original\"] || \"\";\n\n// Se ainda tiver slogans ou sufixos longos, limpa automaticamente\nnome = nome.replace(/\\s*[:|–—·/;]\\s*|\\s+-\\s+.*/, '').trim();\nnome = nome.replace(/\\s+(em|no|na)\\s+[A-Za-zÀ-ÖØ-öø-ÿ\\s]+$/, '').trim();\n\n// Monta a mensagem final: \"[Saudação aleatória] [Nome Limpo]?\"\n// Exemplo: \"Olá, tudo bem? Dra. Leticia Matos?\"\nconst mensagem = `${saudacao} ${nome}?`;\n\n// DELAY NÃO-LINEAR ALEATÓRIO: Entre 120s (2 min) e 210s (3m30s)\n// Exemplo: 137s, 194s, 151s, 208s...\nconst delayMinimo = 120;\nconst delayMaximo = 210;\nconst delaySegundos = Math.floor(Math.random() * (delayMaximo - delayMinimo + 1)) + delayMinimo;\n\n// Formata o número para envio (DDI 55 + DDD + 9XXXX-XXXX)\nconst ddd = String($json[\"DDD\"] || \"\").replace(/\\D/g, \"\");\nconst numero = String($json[\"Número\"] || $json[\"WhatsApp Completo\"] || \"\").replace(/\\D/g, \"\");\n\nlet telefoneCompleto = '';\nif (numero.startsWith('55') && numero.length >= 12) {\n  telefoneCompleto = numero;\n} else if (numero.length === 11) {\n  telefoneCompleto = `55${numero}`;\n} else {\n  telefoneCompleto = `55${ddd}${numero}`;\n}\n\nreturn {\n  json: {\n    ...$json,\n    whatsappDestino: telefoneCompleto,\n    mensagemFinal: mensagem,\n    delaySegundosEspera: delaySegundos,\n    delayMinutosFormatado: `${(delaySegundos / 60).toFixed(1)} min`,\n    dataHoraEnvio: new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' })\n  }\n};"
      },
      "id": "generate-message-delay",
      "name": "Sortear Mensagem & Delay Não-Linear",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evolution.frostforge.tech/message/sendText/sua_instancia",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUA_API_KEY_AQUI"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.whatsappDestino }}\",\n  \"text\": \"{{ $json.mensagemFinal }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "send-whatsapp",
