      ],
      "id": "8cf2c991-b379-4e96-acb7-47d6441acaa5",
      "name": "Buscar Eventos Passados Google Calendar",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first()?.json || {};\nconst estab = $('Loop Estabelecimentos').item?.json || {};\n\n// Pega o token renovado pelo nó 'Renovar Token Google' de forma garantida\nlet accessToken = \"\";\ntry {\n  accessToken = $('Renovar Token Google').item.json.access_token;\n} catch (e) {\n  try {\n    accessToken = $('Renovar Token Google').last().json.access_token;\n  } catch (e2) {\n    accessToken = estab.google_access_token || \"\";\n  }\n}\n\nconst items = res.items || [];\n\n// Filtra apenas agendamentos reais (ignora aniversarios 'birthday', feriados e eventos de sistema)\nconst eventosValidos = items.filter(ev => {\n  if (!ev.id || ev.status === 'cancelled') return false;\n  \n  // Exclui eventos de sistema do Google\n  const eventType = ev.eventType || 'default';\n  if (eventType !== 'default') return false;\n  \n  // Exclui eventos de calendários de feriados automáticos\n  if (ev.organizer && ev.organizer.email && ev.organizer.email.includes('holiday')) return false;\n\n  return true;\n});\n\nreturn eventosValidos.map(ev => ({\n  json: {\n    instancia: estab.instancia,\n    google_calendar_id: estab.google_calendar_id,\n    google_access_token: accessToken,\n    google_event_id: ev.id,\n    summary: ev.summary || 'Agendamento sem nome',\n    description: ev.description || '',\n    start_iso: ev.start?.dateTime || ev.start?.date,\n    end_iso: ev.end?.dateTime || ev.end?.date\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        336
      ],
      "id": "92158506-49a8-49de-9d15-6463443d36e8",
      "name": "Formatar Eventos Passados"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO historico_agendamentos (\n  instancia,\n  google_event_id,\n  summary,\n  description,\n  data_hora_inicio,\n  data_hora_fim\n)\nVALUES (\n  '{{ $json.instancia }}',\n  '{{ $json.google_event_id }}',\n  '{{ $json.summary.replace(/'/g, \"''\") }}',\n  '{{ $json.description.replace(/'/g, \"''\") }}',\n  '{{ $json.start_iso }}',\n  '{{ $json.end_iso }}'\n)\nON CONFLICT (google_event_id) DO NOTHING;\n\nSELECT \n  '{{ $json.google_calendar_id }}' AS google_calendar_id,\n  '{{ $json.google_event_id }}' AS google_event_id,\n  '{{ $json.google_access_token }}' AS google_access_token;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1744,
        336
      ],
      "id": "6b84a85d-63f8-42f8-8d68-1f380691b127",
