      "id": "46b4c247-6497-42b3-b84a-0cb6304518de",
      "name": "Buscar Eventos no Google",
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// ─── Formatação dos eventos encontrados (JavaScript Nativo - Sem Luxon) ──────\nconst inputJson = $input.first()?.json || {};\nconst items = Array.isArray(inputJson.items) ? inputJson.items : [];\n\nif (items.length === 0) {\n  return [{\n    json: {\n      sucesso: false,\n      mensagem: 'Nenhum agendamento ativo foi encontrado para o termo especificado.'\n    }\n  }];\n}\n\nconst eventosFormatados = items.map(ev => {\n  const start = ev.start?.dateTime || ev.start?.date || '';\n  const end   = ev.end?.dateTime   || ev.end?.date   || '';\n  return `Event_ID: ${ev.id} | Título: ${ev.summary} | Início: ${start} | Fim: ${end}`;\n}).join('\\n');\n\nreturn [{\n  json: {\n    sucesso: true,\n    total_encontrados: items.length,\n    eventos_encontrados: eventosFormatados,\n    lista_eventos: items.map(ev => ({\n      event_id: ev.id,\n      titulo: ev.summary,\n      inicio: ev.start?.dateTime || ev.start?.date,\n      fim: ev.end?.dateTime || ev.end?.date\n    })),\n    mensagem: `Encontrado(s) ${items.length} agendamento(s):\\n${eventosFormatados}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
