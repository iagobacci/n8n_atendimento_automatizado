# =============================================================================
# VARIÁVEIS DE AMBIENTE - EXEMPLO
# Renomeie para .env e preencha com seus dados reais
# =============================================================================

# Configuração da Evolution API / Provedor WhatsApp
EVOLUTION_API_URL=https://sua-instancia-evolution.com
EVOLUTION_API_KEY=sua_chave_de_api_aqui
EVOLUTION_INSTANCE_NAME=instancia_principal

# n8n Webhook / Configurações
N8N_BASE_URL=https://seu-n8n.com
N8N_WEBHOOK_TOKEN=seu_token_secreto_aqui

# Provedores de Inteligência Artificial
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar / Google Cloud (OAuth 2.0)
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
